# Variable NAMES only. Copy to .env for local testing and fill in your own values.
# Never commit .env. On Railway these are set by the template.

# Admin key and admin UI password. Must start with "sk-". Generate one with:
#   echo "sk-$(openssl rand -hex 20)"
LITELLM_MASTER_KEY=

# Encrypts provider API keys stored in the database. Never change it after first use.
#   openssl rand -hex 20
LITELLM_SALT_KEY=

# Local test database password (local docker-compose only).
#   openssl rand -hex 20
POSTGRES_PASSWORD=
